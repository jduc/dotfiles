################################
#[[[ Zsh configuration file ]]]#
################################

# History
export HISTFILE=~/.zsh_history
export HISTSIZE=50000
export SAVEHIST=50000
setopt INC_APPEND_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY

export XDG_CONFIG_HOME="$HOME/.config"
KEYTIMEOUT=1

# Completion
setopt auto_list      # list choices on ambiguous completion
setopt auto_menu      # use menu completion
setopt always_to_end  # move cursor to end on single match
setopt extendedglob
setopt clobber


# zstyle ':completion:*' menu no           # show selectable completion menu
# zstyle ':completion:*' verbose yes
# zstyle ':completion:*' group-name ''
# zstyle ':completion:*' squeeze-slashes true
# zstyle ':completion:*:matches' group 'yes'
# zstyle ':completion:*:options' description 'yes'
# zstyle ':completion:*:options' auto-description '%d'
# zstyle ':completion:*:corrections' format ' %F{green}-- %d (errors: %e) --%f'
# zstyle ':completion:*:descriptions' format ' %F{yellow}-- %d --%f'
# zstyle ':completion:*:messages' format ' %F{purple} -- %d --%f'
# zstyle ':completion:*:warnings' format ' %F{red}-- no matches found --%f'
# zstyle ':completion:*' format ' %F{yellow}-- %d --%f'
# zstyle ':completion:*:functions' ignored-patterns '(_*|pre(cmd|exec))'

# Directories
zstyle ':completion:*:default' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*:*:cd:*' tag-order local-directories directory-stack path-directories
zstyle ':completion:*:-tilde-:*' group-order 'named-directories' 'path-directories' 'users' 'expand'

# Kill
zstyle ':completion:*:*:*:*:processes' command 'ps -u $LOGNAME -o pid,user,command -w'
zstyle ':completion:*:*:kill:*:processes' list-colors '=(#b) #([0-9]#) ([0-9a-z-]#)*=01;36=0=01'
zstyle ':completion:*:*:kill:*' insert-ids single

# Man
zstyle ':completion:*:manuals' separate-sections true
zstyle ':completion:*:manuals.(^1*)' insert-sections true

# Don't re-offer already-typed args to rm/kill/diff
zstyle ':completion:*:(rm|kill|diff):*' ignore-line other
zstyle ':completion:*:rm:*' file-patterns '*:all-files'

# Aliases
alias len='wc -l'
alias refresh='exec zsh'   # re-sourcing re-wraps plugin widgets and can crash the shell
alias untar='tar -xzvf'
alias vim='nvim'
alias t='task'
alias ls='eza'

# Vi mode + keybindings
bindkey -v
bindkey '^?' backward-delete-char
bindkey '^[[Z' reverse-menu-complete
bindkey '^K' autosuggest-accept


_brew_prefix="$(brew --prefix)"

# Homebrew completion
FPATH="$_brew_prefix/share/zsh/site-functions:${FPATH}"

# Plugins (antidote). fzf-tab is kind:defer so it loads after compinit and fzf below
_antidote="$_brew_prefix/opt/antidote/share/antidote/antidote.zsh"
[[ -f "$_antidote" ]] && source "$_antidote" && antidote load
unset _antidote _brew_prefix

# Completion init (after antidote so plugin completions are on fpath)
autoload -Uz compinit
if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qN.mh+24) ]]; then
  compinit
else
  compinit -C
fi

# Tools
eval "$(zoxide init zsh)"
type starship_zle-keymap-select >/dev/null || eval "$(starship init zsh)"
eval "$(mise activate zsh)"


# Env / PATH
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$HOME/.ghcup/bin:$PATH"
[ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"

# fzf shell integration: Ctrl-T (files), Ctrl-R (history), Alt-C (cd). Tab is taken over by fzf-tab (deferred)
source <(fzf --zsh)
